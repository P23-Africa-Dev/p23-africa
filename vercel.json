{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php-launcher@file:../../builders/vercel-php-launcher",
            "config": {
                "excludeFiles": "{public/images/**,public/fonts/**,public/playbook/**,node_modules/**,tests/**,vendor/google/apiclient-services/**,builders/**}"
            }
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "public"
            }
        }
    ],
    "routes": [
        { "src": "/", "dest": "/api/index.php" },
        { "src": "/index.php", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "P23 Africa",
        "APP_ENV": "production",
        "APP_KEY": "base64:tTxSdtXbboGDXo23hrKEoMaalsTSi52CwX8aaEbYKac=",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "BROADCAST_CONNECTION": "log",
        "MAIL_MAILER": "log",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/database.sqlite",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php"
    }
}
