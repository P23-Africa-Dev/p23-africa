FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_sqlite

WORKDIR /app

FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json vite.config.js tailwind.config.js postcss.config.js ./
COPY resources ./resources

RUN npm ci --include=dev && npm run build

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .
COPY --from=assets /app/public/build /app/public/build

ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_KEY=base64:tTxSdtXbboGDXo23hrKEoMaalsTSi52CwX8aaEbYKac= \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/vercel.sqlite \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && rm -f bootstrap/cache/*.php \
    && php -r '$pdo = new PDO("sqlite:/app/database/vercel.sqlite"); $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION); $pdo->exec(file_get_contents("/app/database/schema/vercel-preview.sql"));' \
    && composer dump-autoload --no-dev --optimize --no-interaction

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data deploy/docker/Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy /app/storage /app/bootstrap/cache /app/database

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_KEY=base64:tTxSdtXbboGDXo23hrKEoMaalsTSi52CwX8aaEbYKac= \
    APP_NAME="P23 Africa" \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=error \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync \
    BROADCAST_CONNECTION=log \
    MAIL_MAILER=log \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/vercel.sqlite

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
